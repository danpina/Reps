# Copy to .env.local and fill in from your Supabase project settings (API section).

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
# Used by the RLS test suite to create and tear down test users.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links and email confirmations redirect back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4 (roleplay + feedback). Not read until then.
ANTHROPIC_API_KEY=
