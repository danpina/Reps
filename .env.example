# Copy to .env.local and fill in from your Supabase project settings (API section).

# Safe to expose to the browser. The NEXT_PUBLIC_ prefix is what makes Next.js
# inline these into the client bundle, so it is required, not decorative.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
# Used by the RLS test suite to create and tear down test users.
SUPABASE_SECRET_KEY=

# Where magic links and email confirmations redirect back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rehearsal partner and review. Server-only — never prefix with NEXT_PUBLIC_,
# which would ship a paid key to every browser that loads the app.
#
# Its presence is the switch: with a key the app makes real calls, without one
# it falls back to the scripted partner and costs nothing. That means a local
# checkout works with this left blank.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. Set this to trade quality for cost —
# claude-sonnet-5 is a reasonable second choice if the bills get annoying.
ANTHROPIC_MODEL=
