# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets stay local, the template is committed
.env*
!.env.example

# loose credential notes, so a stray `git add -A` cannot publish them.
# Scoped to note-like extensions rather than a bare `*password*` — that
# blanket form also matched legitimate source (password-form.tsx,
# reset-password/), silently keeping it out of `git status` entirely.
*PWD*.txt
*PWD*.md
*password*.txt
*password*.md
*secret*.txt
*secret*.md
*credentials*.txt
*credentials*.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Convenience bundle of all migrations, regenerated on demand
supabase/APPLY_ALL.local.sql
supabase/APPLY_TRACKS_2_9.local.sql
supabase/APPLY_PHASE5.local.sql
supabase/APPLY_TIMEZONE_FIX.local.sql
supabase/APPLY_ROLEPLAY.local.sql
supabase/APPLY_MISSIONS.local.sql
supabase/APPLY_SUMMARIES_AND_CHECKS.local.sql
supabase/APPLY_REHEARSAL_SCOPE.local.sql
